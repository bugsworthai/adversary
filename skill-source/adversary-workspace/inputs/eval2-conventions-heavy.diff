@@ -0,0 +1,11 @@
+enum OrdersComposition {
+    @MainActor
+    static func makeOrdersViewModel() -> OrdersViewModel {
+        let env = AppEnvironment.shared
+        let repository = RemoteOrdersRepository(client: env.apiClient, cache: env.responseCache)
+        return OrdersViewModel(
+            getOrders: DefaultGetOrdersUseCase(repository: repository),
+            formatter: OrderRowFormatter(currency: CurrencyFormatter(locale: env.locale))
+        )
+    }
+}
