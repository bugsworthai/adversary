@@ -0,0 +1,15 @@
+protocol GetOrdersUseCase {
+    func execute() async throws -> [Order]
+}
+
+final class DefaultGetOrdersUseCase: GetOrdersUseCase {
+    private let repository: OrdersRepository
+
+    init(repository: OrdersRepository) {
+        self.repository = repository
+    }
+
+    func execute() async throws -> [Order] {
+        try await repository.fetchOrders()
+    }
+}
diff --git a/ios/Orders/Presentation/OrderRowFormatter.swift b/ios/Orders/Presentation/OrderRowFormatter.swift
new file mode 100644
index 0000000..2222222
--- /dev/null
+++ b/ios/Orders/Presentation/OrderRowFormatter.swift
@@ -0,0 +1,25 @@
+protocol OrderRowFormatting {
+    func row(for order: Order) -> OrderRow
+}
+
+struct OrderRowFormatter: OrderRowFormatting {
+    let currency: CurrencyFormatter
+
+    func row(for order: Order) -> OrderRow {
+        OrderRow(
+            id: order.id,
+            title: order.displayNumber,
+            amount: currency.string(fromMinorUnits: order.totalMinorUnits),
+            statusLabel: label(for: order.status)
+        )
+    }
+
+    private func label(for status: OrderStatus) -> String {
+        switch status {
+        case .pending: return OrdersStrings.statusPending
+        case .shipped: return OrdersStrings.statusShipped
+        case .delivered: return OrdersStrings.statusDelivered
+        case .cancelled: return OrdersStrings.statusCancelled
+        }
+    }
+}
