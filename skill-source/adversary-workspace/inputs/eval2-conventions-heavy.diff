@@ -0,0 +1,35 @@
+import XCTest
+@testable import OrdersFeature
+
+@MainActor
+final class OrdersViewModelTests: XCTestCase {
+    func testLoad_mapsOrdersToRows() async {
+        let useCase = GetOrdersUseCaseMock(result: .success([.fixture(number: "A-100")]))
+        let formatter = OrderRowFormattingStub()
+        let sut = OrdersViewModel(getOrders: useCase, formatter: formatter)
+
+        await sut.load()
+
+        XCTAssertEqual(sut.rows.map(\.title), ["A-100"])
+    }
+
+    func testLoad_failure_clearsRows() async {
+        let useCase = GetOrdersUseCaseMock(result: .failure(TestError.network))
+        let formatter = OrderRowFormattingStub()
+        let sut = OrdersViewModel(getOrders: useCase, formatter: formatter)
+
+        await sut.load()
+
+        XCTAssertTrue(sut.rows.isEmpty)
+    }
+
+    func testLoad_manyOrders_showsPaginationHint() async {
+        let useCase = GetOrdersUseCaseMock(result: .success(Array(repeating: .fixture(), count: 60)))
+        let formatter = OrderRowFormattingStub()
+        let sut = OrdersViewModel(getOrders: useCase, formatter: formatter)
+
+        await sut.load()
+
+        XCTAssertTrue(sut.showPaginationHint)
+    }
+}
