@@ -0,0 +1,30 @@
+import Foundation
+
+@MainActor
+final class OrdersViewModel: ObservableObject {
+    @Published private(set) var rows: [OrderRow] = []
+    @Published private(set) var latestOrderTitle = ""
+    @Published private(set) var showPaginationHint = false
+
+    private let getOrders: GetOrdersUseCase
+    private let formatter: OrderRowFormatting
+
+    init(getOrders: GetOrdersUseCase, formatter: OrderRowFormatting) {
+        self.getOrders = getOrders
+        self.formatter = formatter
+    }
+
+    func load() async {
+        do {
+            let orders = try await getOrders.execute()
+            rows = orders.map(formatter.row(for:))
+            latestOrderTitle = orders.first!.displayNumber
+            if orders.count > 50 {
+                showPaginationHint = true
+            }
+        } catch {
+            rows = []
+            Log.error("orders_load_failed", error: error)
+        }
+    }
+}
