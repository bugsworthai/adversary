+import XCTest
+@testable import ProfileFeature
+
+@MainActor
+final class ProfileViewModelTests: XCTestCase {
+    func testLoad_setsDisplayName() async throws {
+        let session = URLSession.stubbed(json: ProfileFixtures.standard)
+        let inbox = InboxStoreMock(messages: [])
+        let sut = ProfileViewModel(getProfile: GetProfileUseCaseMock(), session: session,
+                                   cacheURL: .temporaryFile(), inbox: inbox)
+
+        try await sut.load()
+
+        XCTAssertEqual(sut.displayName, "Sam Rivera")
+    }
+
+    func testLoad_setsMemberSince() async throws {
+        let session = URLSession.stubbed(json: ProfileFixtures.standard)
+        let inbox = InboxStoreMock(messages: [])
+        let sut = ProfileViewModel(getProfile: GetProfileUseCaseMock(), session: session,
+                                   cacheURL: .temporaryFile(), inbox: inbox)
+
+        try await sut.load()
+
+        XCTAssertEqual(sut.memberSince, "March 2021")
+    }
+
+    func testLoad_countsUnreadMessages() async throws {
+        let session = URLSession.stubbed(json: ProfileFixtures.standard)
+        let inbox = InboxStoreMock(messages: [.unread(), .unread(), .read()])
+        let sut = ProfileViewModel(getProfile: GetProfileUseCaseMock(), session: session,
+                                   cacheURL: .temporaryFile(), inbox: inbox)
+
+        try await sut.load()
+
+        XCTAssertEqual(sut.unreadCount, 2)
+    }
+}
