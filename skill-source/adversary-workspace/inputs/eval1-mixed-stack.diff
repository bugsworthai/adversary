+package com.example.shop
+
+data class CartLine(val sku: String, val unitPrice: Double, val quantity: Int)
+
+data class CartSummary(val items: List<CartLine>) {
+    val subtotal: Double get() = items.sumOf { it.unitPrice * it.quantity }
+    val tax: Double get() = subtotal * 0.0825
+    val total: Double get() = subtotal + tax
+    fun qualifiesForFreeShipping(): Boolean = total >= 50.0
+}
