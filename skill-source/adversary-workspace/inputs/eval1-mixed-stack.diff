+++ b/web/src/storage/StorageProviderFactory.ts
@@ -0,0 +1,27 @@
+import { LocalStorageProvider } from "./LocalStorageProvider";
+
+export type ProviderKind = "local" | "s3" | "gcs" | "azure";
+
+export interface StorageProviderOptions {
+  region?: string;
+  retries?: number;
+  encryption?: "none" | "aes256";
+  cacheTtlSeconds?: number;
+}
+
+export interface StorageProvider {
+  put(key: string, value: Blob): Promise<void>;
+  get(key: string): Promise<Blob | undefined>;
+}
+
+const registry: Partial<Record<ProviderKind, (o: StorageProviderOptions) => StorageProvider>> = {
+  local: () => new LocalStorageProvider(),
+};
+
+export class StorageProviderFactory {
+  static create(kind: ProviderKind, options: StorageProviderOptions = {}): StorageProvider {
+    const make = registry[kind];
+    if (!make) throw new Error(`${kind} storage is not implemented yet`);
+    return make(options);
+  }
+}
