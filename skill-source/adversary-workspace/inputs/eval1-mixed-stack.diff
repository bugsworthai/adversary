+enum HTTPMethod {
+    case get, post, put, delete
+
+    var rawName: String {
+        switch self {
+        case .get: return "GET"
+        case .post: return "POST"
+        case .put: return "PUT"
+        case .delete: return "DELETE"
+        }
+    }
+}
