-import { LocalStorageProvider } from "../storage/LocalStorageProvider";
+import { StorageProviderFactory } from "../storage/StorageProviderFactory";
 import type { Draft } from "./types";

-const storage = new LocalStorageProvider();
+const storage = StorageProviderFactory.create("local");

 export async function saveDraft(draft: Draft): Promise<void> {
   await storage.put(`draft:${draft.id}`, new Blob([JSON.stringify(draft)]));
 }

+export async function exportDrafts(drafts: Draft[], zip: boolean, includeDeleted: boolean, notify: boolean) {
+  const selected = includeDeleted ? drafts : drafts.filter((d) => !d.deletedAt);
+  const file = zip ? await zipDrafts(selected) : toJsonFile(selected);
+  await downloadFile(file);
+  if (notify) showToast("Export complete");
+}
+
+export async function onExportClicked(drafts: Draft[]) {
+  await exportDrafts(drafts, true, false, true);
+}
